{
	"name": "@wonderhoy-labs/shinonome",
	"version": "0.3.0",
	"description": "The Pixel's desktop in any web page over adb, with video, input, sound, clipboard and files.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wonderhoy-labs/shinonome.git",
		"directory": "packages/shinonome"
	},
	"exports": {
		".": "./src/index.ts",
		"./shinonome.apk": "./shinonome.apk"
	},
	"files": [
		"dist",
		"shinonome.apk"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./shinonome.apk": "./shinonome.apk"
		}
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build && cp ../../android/app/build/outputs/apk/release/app-release.apk shinonome.apk",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@yume-chan/adb": "2.6.4",
		"@yume-chan/android-bin": "2.1.0"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"typescript": "7.0.2",
		"vite": "8.3.6",
		"vitest": "4.1.12"
	}
}
